# Turso (libSQL) — base de datos de los flujos.
# Sin estas variables la app funciona igual, pero guarda los flujos solo en el navegador.
# Si Turso está conectado al proyecto de Vercel, trae los valores con:
#   vercel env pull .env.local
TURSO_DATABASE_URL=libsql://<base-de-datos>-<organizacion>.turso.io
TURSO_AUTH_TOKEN=
